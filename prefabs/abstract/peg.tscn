[sub_resource type="Shader" id="Shader_g4jk8"]
code = "shader_type canvas_item;

uniform vec4 highlight_color : source_color = vec4(1.0, 1.0, 0.0, 1.0); // Defaults to yellow
uniform bool highlight = false;

void fragment() {
    vec4 cur = COLOR;
    
    if (highlight) {
        // 1. Calculate how \"bright\" the RGB channels are (ignoring alpha)
        // A true black pixel will have an RGB sum of 0.0
        float rgb_sum = cur.r + cur.g + cur.b;
        
        // 2. Create a smooth blending factor for anti-aliasing.
        // If rgb_sum is 0.0, factor is 1.0 (fully yellow).
        // As rgb_sum approaches 0.2, it smoothly fades out.
        // GLSL colors range from 0.0 to 1.0, so 0.2 represents your threshold.
        float blend_factor = smoothstep(1.0, 0.0, rgb_sum);
        
        // 3. Mix the original color with the highlight color based on the factor.
        // We preserve the original alpha channel so anti-aliased transparency stays smooth.
        vec3 final_rgb = mix(cur.rgb, highlight_color.rgb, blend_factor);
        
        COLOR = vec4(final_rgb, cur.a);
    }
}
"

